# TLS in front of the Baby Feed sync server.
#
# THIS IS BABY FEED'S OWN CADDY — its own binary (server/bin/caddy), its own
# config, its own ports, its own certificate storage and its own launchd job
# (com.babyfeed.caddy). It does not read, share or modify any other Caddy setup
# on this machine, and stopping or breaking one has no effect on the other.
#
# PORTS — why these numbers:
#   8791  the sync server itself
#   9444  this Caddy's HTTPS port, unprivileged so it needs no root
#   9081  this Caddy's HTTP port
# The router forwards an external port to 9444. External 443 is not available:
# something else on this machine is already behind it, and two services can't
# share one external port without one fronting the other — exactly the coupling
# this project is avoiding. So the address carries a port, which is fine: it's
# typed into the app once and then lives in a QR code.
#
# CERTIFICATES — why the DNS challenge, and why a custom Caddy binary:
#   - HTTP-01 needs inbound port 80. Comcast blocks it on residential lines.
#   - TLS-ALPN-01 needs inbound port 443 pointed at THIS Caddy. It isn't.
#   - DNS-01 is left, and it needs a DuckDNS provider module that the stock
#     Homebrew Caddy does not include. server/bin/caddy is a build that has it,
#     downloaded from caddyserver.com. `brew upgrade caddy` will not touch it.
#
# Both values come from ~/baby-feed-data/.env via the launchd job, so the
# hostname and the DuckDNS token are never in this repo.

{
	http_port 9081
	https_port 9444
	email brian@innjoybnb.com
}

{$BABYFEED_HOSTNAME}:9444 {
	tls {
		dns duckdns {$BABYFEED_DUCKDNS_TOKEN}
		# DuckDNS serves its own TXT records; asking the authoritative server
		# directly avoids waiting on a public resolver's cache during issuance.
		resolvers 8.8.8.8 1.1.1.1
	}

	reverse_proxy 127.0.0.1:8791 {
		# Pushes and pulls are small JSON; a phone on a bad connection just
		# needs longer than the default to finish one.
		transport http {
			read_timeout 60s
			write_timeout 60s
			dial_timeout 10s
		}
		# The rate limiter in front of pairing keys on the real client address.
		# Without this every request looks like it came from 127.0.0.1, and one
		# person guessing invite codes would lock out both phones.
		header_up X-Forwarded-For {remote_host}
	}

	encode gzip

	log {
		output file /Users/brian/baby-feed-data/logs/caddy-access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format console
		level ERROR
	}
}
