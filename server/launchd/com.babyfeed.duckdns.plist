<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps Baby Feed's own DuckDNS hostname current. Every 5 minutes: a stale
     record means both phones silently stop syncing. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.babyfeed.duckdns</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/baby-feed/server/scripts/duckdns-update.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/baby-feed-data/logs/duckdns.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/baby-feed-data/logs/duckdns.launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>BABYFEED_DATA_DIR</key>
        <string>__HOME__/baby-feed-data</string>
    </dict>
</dict>
</plist>
